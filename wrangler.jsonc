{
  // Cloudflare Workers 설정: 정적 사이트 + /api/* 만 Worker 가 처리
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "local-lab",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "local-lab.app", "custom_domain": true }
  ]
}
